# Privy Auth
PRIVY_APP_ID=your_privy_app_id
PRIVY_SECRET_KEY=your_privy_secret

# Local dev → DATABASE_URL=postgresql://anonpay:anonpay@localhost:5432/anonpay
DATABASE_URL=postgresql://anonpay:anonpay@db:5432/anonpay

# Blockchain RPC Endpoints
BASE_RPC_URL=https://mainnet.base.org
ARC_RPC_URL=https://mainnet.arc.io

# Encryption (generate with: python scripts/generate_key.py)
ENCRYPTION_KEY=your_fernet_key_here

# CORS / Frontend
FRONTEND_URL=http://localhost:3000

# App
ENVIRONMENT=development
LOG_LEVEL=INFO